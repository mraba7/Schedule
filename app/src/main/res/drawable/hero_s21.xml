<?xml version="1.0" encoding="utf-8"?>
<!-- Section identity tint over the glass panel. A diagonal gradient, the same
     depth trick Samsung uses on the weather widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#733B82F6"
        android:centerColor="#4D3B82F6"
        android:endColor="#1F3B82F6" />
</shape>
