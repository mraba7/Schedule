<?xml version="1.0" encoding="utf-8"?>
<!-- Section identity tint over the glass panel. A diagonal gradient, the same
     depth trick Samsung uses on the weather widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#4D94A3B8"
        android:centerColor="#3394A3B8"
        android:endColor="#1494A3B8" />
</shape>
