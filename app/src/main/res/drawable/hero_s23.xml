<?xml version="1.0" encoding="utf-8"?>
<!-- Section identity tint over the glass panel. A diagonal gradient, the same
     depth trick Samsung uses on the weather widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#4DF59E0B"
        android:centerColor="#33F59E0B"
        android:endColor="#14F59E0B" />
</shape>
