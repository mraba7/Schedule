<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView android:id="@+id/design_image" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />
    <TextView android:id="@+id/design_task" android:layout_width="48dp"
        android:layout_height="40dp" android:layout_gravity="top|left"
        android:background="@android:color/transparent" android:visibility="gone"
        android:clickable="true" android:focusable="true" />
    <TextView android:id="@+id/design_schedule" android:layout_width="140dp"
        android:layout_height="26dp" android:layout_gravity="top|left"
        android:background="@android:color/transparent" android:visibility="gone"
        android:clickable="true" android:focusable="true" />
    <FrameLayout android:id="@+id/design_peeks" android:layout_width="match_parent"
        android:layout_height="match_parent" android:layoutDirection="ltr" />
</FrameLayout>
