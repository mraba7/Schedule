<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="ltr">
    <ImageView android:id="@+id/utility_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="bottom" android:orientation="horizontal">
        <TextView android:id="@+id/utility_flip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackground" android:focusable="true" />
        <TextView android:id="@+id/utility_shortcuts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackground" android:focusable="true" />
    </LinearLayout>
</FrameLayout>
