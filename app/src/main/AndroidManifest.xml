<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Minute-accurate countdown. Without it the widget falls back to a
         60-second alarm window, which is still fine for classroom use. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- only used to ask GitHub for the newest release -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- so the update button can hand the APK to the system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OneUISchedule">

        <activity android:name=".widget.DesignLessonActivity" android:exported="false" />
        <receiver android:name=".widget.TicketWidgetReceiver" android:exported="false"
            android:label="@string/design_ticket_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_ticket_info" />
        </receiver>
        <receiver android:name=".widget.OrbitWidgetReceiver" android:exported="false"
            android:label="@string/design_orbit_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_orbit_info" />
        </receiver>
        <receiver android:name=".widget.EditorialWidgetReceiver" android:exported="false"
            android:label="@string/design_editorial_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_editorial_info" />
        </receiver>
        <receiver android:name=".widget.BentoWidgetReceiver" android:exported="false"
            android:label="@string/design_bento_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_bento_info" />
        </receiver>
        <receiver android:name=".widget.RouteWidgetReceiver" android:exported="false"
            android:label="@string/design_route_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_route_info" />
        </receiver>
        <receiver android:name=".widget.SportWidgetReceiver" android:exported="false"
            android:label="@string/design_sport_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_sport_info" />
        </receiver>
        <receiver android:name=".widget.BlueprintWidgetReceiver" android:exported="false"
            android:label="@string/design_blueprint_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_blueprint_info" />
        </receiver>

        <receiver android:name=".widget.GlassWidgetReceiver" android:exported="false" android:label="@string/design_glass_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/design_glass_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.ScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mrabah.oneuischedule.TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.LuxuryScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_luxury_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/luxury_schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CardsScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_cards_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cards_schedule_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CompactScheduleWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compact_schedule_widget_info" />
        </receiver>
        <receiver
            android:name=".notify.PeriodAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mrabah.oneuischedule.BELL" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.NowWidgetReceiver"
            android:exported="true"
            android:label="الحصة الآن">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidgetReceiver"
            android:exported="true"
            android:label="العدّ التنازلي">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekGridWidgetReceiver"
            android:exported="true"
            android:label="الأسبوع كاملًا">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekgrid_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TimelineWidgetReceiver"
            android:exported="true"
            android:label="خط اليوم الزمني">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timeline_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NextUpWidgetReceiver"
            android:exported="true"
            android:label="الحصص القادمة">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nextup_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SyllabusWidgetReceiver"
            android:exported="true"
            android:label="تقدّم المنهج">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/syllabus_widget_info" />
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
